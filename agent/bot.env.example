# Sooth Hedge bot env file. Copy to /home/zak/sooth-hedge.env and run: chmod 600 /home/zak/sooth-hedge.env
# Never commit the filled file. The bot never prints these values.

# Bot wallet. An allowed creator (MarketFactory.setCreatorAllowed), not the node admin.
# It holds BNB for gas and hUSD-DEMO for market funding and trades.
BOT_PRIVATE_KEY=
# CoinMarketCap key. Empty uses the keyless API.
CMC_API_KEY=
# RPC for reads and sends.
BSC_RPC_URL=
# RPC for getLogs (chunks of 5000 blocks).
LOG_RPC_URL=https://bsc-rpc.publicnode.com
# Relative to agent/ (or to contracts/).
DEPLOYMENT_FILE=../contracts/deployments/56.json
# State file (markets, spend, schedule). Relative to agent/.
BOT_STATE=./bot-state.json
# Daily trade spend cap in hUSD.
BOT_DAILY_SPEND=200
# Daily create time (UTC, HH:MM).
CREATE_AT_UTC=21:05
# Market deadline time (UTC, HH:MM). 21:00 is the US close in winter, 20:00 in summer.
DEADLINE_AT_UTC=21:00
# Dates with no deadline, comma separated YYYY-MM-DD (US market holidays).
BOT_SKIP_DATES=
# 1 publishes the page to Cloudflare Pages after new markets and at most hourly after trades.
BOT_PUBLISH=0
CF_PAGES_PROJECT=noesis
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# 1 (default) sends nothing. Set 0 to send transactions.
BOT_DRY_RUN=1

# Optional tuning (defaults shown).
# BOT_SETTLE_SEC=60
# BOT_AGENT_SEC=900
# BOT_TICK_SEC=5
# BOT_BBASE=500
# BOT_MAX_INPUT=2500
# BOT_BANKROLL=100
# BOT_SLIPPAGE=0.02
# BOT_GAS_GWEI=0.05
# BOT_CMC_TTL_SEC=3600
# BOT_LOG_CONFIRMATIONS=2
# BOT_PUBLISH_MIN_SEC=1800
# BOT_COURNOT_RESOLVE=0
# Cached Cournot answers per market (no new call): 0xMARKET:ID[:invert],...
# BOT_COURNOT_IDS=
# COURNOT_OFFLINE=1
# Atlas Pull API key for the Consensus Score (server only, never in the page)
# ATLAS_API_KEY=
